{
  "name": "keyframe-sdk",
  "version": "0.1.0",
  "description": "JavaScript client for Keyframe: summaries and typed metadata fields extracted from images and video.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/sdk.test.js"
  },
  "keywords": [
    "keyframe",
    "video",
    "image",
    "metadata",
    "extraction",
    "summarization",
    "sdk"
  ],
  "author": "Joel Christner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jchristn/Keyframe"
  }
}
