            "description": "The VideoAnalysisResponse of a succeeded job. Returns 409 until the job has succeeded."
          }
        },
        {
          "name": "Cancel job",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1.0/jobs/{{jobId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "jobs",
                "{{jobId}}",
                "cancel"
              ]
            },
            "description": "Cancels a queued or running job. Returns 409 when the job already finished."
          }
        },
        {
          "name": "Delete job",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1.0/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Deletes a finished job and its result. Returns 409 for a queued or running job."
          }
        }
      ]
    },
