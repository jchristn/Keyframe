    {
      "name": "Image",
      "description": "Synchronous image analysis. Supply the image by Url or base64 Data. Every Context item is included in every prompt the request produces. The response carries Results (keyed the way you asked), per-field detail in Fields, media Properties, and Telemetry with stage timings, every model call, and token counts.",
      "item": [
        {
          "name": "Analyze image (URL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1.0/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "image"
              ]
            },
            "description": "Summary plus four typed fields from an image URL, with a Context list. Private-network URLs are refused unless Media.AllowPrivateNetworkUrls is true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Image\": {\n    \"Url\": \"{{sampleImageUrl}}\"\n  },\n  \"Context\": [\n    {\n      \"Label\": \"Source\",\n      \"Text\": \"Photos submitted by pet adoption volunteers.\"\n    },\n    \"Animals wearing orange collars are already adopted.\"\n  ],\n  \"Functions\": {\n    \"Summarize\": {\n      \"Enable\": true,\n      \"Key\": \"Summary\",\n      \"MaxWords\": 60,\n      \"Style\": \"Paragraph\"\n    },\n    \"Extract\": {\n      \"Enable\": true,\n      \"Mode\": \"Combined\",\n      \"Fields\": [\n        {\n          \"Key\": \"hasCats\",\n          \"Type\": \"Boolean\",\n          \"Prompt\": \"Does this image have cats?\"\n        },\n        {\n          \"Key\": \"dogCount\",\n          \"Type\": \"Integer\",\n          \"Prompt\": \"How many dogs do you see in this image?\",\n          \"Minimum\": 0\n        },\n        {\n          \"Key\": \"setting\",\n          \"Type\": \"Enum\",\n          \"Prompt\": \"Where was this taken?\",\n          \"Options\": [\n            \"Indoors\",\n            \"Outdoors\",\n            \"Unknown\"\n          ]\n        },\n        {\n          \"Key\": \"colors\",\n          \"Type\": \"StringList\",\n          \"Prompt\": \"List the dominant colors.\",\n          \"MaxItems\": 5\n        }\n      ]\n    }\n  },\n  \"IncludeProperties\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Analyze image (base64, per-field)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1.0/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "image"
              ]
            },
            "description": "Same request with inline base64 data and PerField mode, which makes one model call per field. Replace {{sampleImageBase64}} with base64 image bytes (for example: base64 -i photo.jpg).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Image\": {\n    \"Data\": \"{{sampleImageBase64}}\",\n    \"MediaType\": \"image/jpeg\"\n  },\n  \"Context\": \"Single string context is accepted too.\",\n  \"Functions\": {\n    \"Summarize\": {\n      \"Enable\": false\n    },\n    \"Extract\": {\n      \"Enable\": true,\n      \"Mode\": \"PerField\",\n      \"Fields\": [\n        {\n          \"Key\": \"hasCats\",\n          \"Type\": \"Boolean\",\n          \"Prompt\": \"Does this image have cats?\"\n        },\n        {\n          \"Key\": \"dogCount\",\n          \"Type\": \"Integer\",\n          \"Prompt\": \"How many dogs do you see in this image?\",\n          \"Minimum\": 0\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Analyze image (choose endpoint)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1.0/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "image"
              ]
            },
            "description": "Selects a configured endpoint by name and overrides its model. An unknown endpoint name returns 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Image\": {\n    \"Url\": \"{{sampleImageUrl}}\"\n  },\n  \"Model\": {\n    \"Endpoint\": \"{{endpointName}}\",\n    \"Name\": null\n  },\n  \"Functions\": {\n    \"Summarize\": {\n      \"Enable\": true,\n      \"Style\": \"Caption\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Probe media",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1.0/probe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "probe"
              ]
            },
            "description": "Deterministic media properties from ffprobe: dimensions, duration, codecs, tags. No model calls.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Media\": {\n    \"Url\": \"{{sampleVideoUrl}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Video",
      "description": "Video analysis runs as a background job. The response is 202 with the job unless Wait is true and the job finishes within WaitTimeoutMs, in which case it is 200 with the full result. The test scripts store the job id in the jobId collection variable for the Jobs folder.",
      "item": [
        {
          "name": "Analyze video (job)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1.0/video",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "video"
              ]
            },
            "description": "Queues a job with scenes, per-scene captions and fields, a transcript, and whole-video summary and fields. Poll Jobs / Get job, then Jobs / Get job result.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Video\": {\n    \"Url\": \"{{sampleVideoUrl}}\"\n  },\n  \"Context\": [\n    \"Recorded keynote at a developer conference.\"\n  ],\n  \"Functions\": {\n    \"Summarize\": {\n      \"Enable\": true,\n      \"MaxWords\": 150\n    },\n    \"Extract\": {\n      \"Enable\": true,\n      \"Fields\": [\n        {\n          \"Key\": \"speakerCount\",\n          \"Type\": \"Integer\",\n          \"Prompt\": \"How many distinct speakers appear?\"\n        }\n      ]\n    },\n    \"Scenes\": {\n      \"Enable\": true,\n      \"FramesPerScene\": 3,\n      \"Detection\": {\n        \"Threshold\": 0.3,\n        \"MinSceneMs\": 2000,\n        \"MaxSceneMs\": 60000,\n        \"MaxScenes\": 200\n      },\n      \"Summarize\": {\n        \"Enable\": true,\n        \"Style\": \"Caption\"\n      },\n      \"Extract\": {\n        \"Enable\": true,\n        \"Fields\": [\n          {\n            \"Key\": \"showsSlide\",\n            \"Type\": \"Boolean\",\n            \"Prompt\": \"Is a presentation slide visible?\"\n          }\n        ]\n      }\n    },\n    \"Transcribe\": {\n      \"Enable\": true,\n      \"Language\": \"en\"\n    }\n  },\n  \"IncludeKeyframeData\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('job accepted or finished', function () { pm.expect([200, 202]).to.include(pm.response.code); });",
                  "const body = pm.response.json();",
                  "if (body.Id && body.Id.startsWith('kfj_')) { pm.collectionVariables.set('jobId', body.Id); }",
                  "const header = pm.response.headers.get('x-keyframe-job-id');",
                  "if (header) { pm.collectionVariables.set('jobId', header); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Analyze video (wait)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1.0/video",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "video"
              ]
            },
            "description": "Waits up to WaitTimeoutMs (capped by Jobs.MaxWaitTimeoutMs) and returns the result inline when the job succeeds in time. A job that finishes without succeeding returns 200 with the job so you can read Status and Error.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Video\": {\n    \"Url\": \"{{sampleVideoUrl}}\"\n  },\n  \"Wait\": true,\n  \"WaitTimeoutMs\": 120000,\n  \"Functions\": {\n    \"Scenes\": {\n      \"Enable\": true,\n      \"Summarize\": {\n        \"Enable\": true,\n        \"Style\": \"Caption\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('job accepted or finished', function () { pm.expect([200, 202]).to.include(pm.response.code); });",
                  "const body = pm.response.json();",
                  "if (body.Id && body.Id.startsWith('kfj_')) { pm.collectionVariables.set('jobId', body.Id); }",
                  "const header = pm.response.headers.get('x-keyframe-job-id');",
                  "if (header) { pm.collectionVariables.set('jobId', header); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Analyze video (text-only reduction)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1.0/video",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "video"
              ]
            },
            "description": "With TextModel set, the whole-video summary and fields are produced by a text-only model from the scene results and transcript instead of from frames.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Video\": {\n    \"Url\": \"{{sampleVideoUrl}}\"\n  },\n  \"TextModel\": {\n    \"Endpoint\": \"{{endpointName}}\"\n  },\n  \"Functions\": {\n    \"Summarize\": {\n      \"Enable\": true\n    },\n    \"Scenes\": {\n      \"Enable\": true,\n      \"Summarize\": {\n        \"Enable\": true\n      }\n    },\n    \"Transcribe\": {\n      \"Enable\": true\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('job accepted or finished', function () { pm.expect([200, 202]).to.include(pm.response.code); });",
                  "const body = pm.response.json();",
                  "if (body.Id && body.Id.startsWith('kfj_')) { pm.collectionVariables.set('jobId', body.Id); }",
                  "const header = pm.response.headers.get('x-keyframe-job-id');",
                  "if (header) { pm.collectionVariables.set('jobId', header); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Jobs",
      "description": "Durable background jobs. Status is Queued, Running, Succeeded, Failed, Canceled, or Interrupted (the server stopped mid-job). Finished jobs are pruned after Jobs.RetentionDays.",
      "item": [
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1.0/jobs?pageNumber=1&pageSize=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "jobs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Succeeded",
                  "description": "Queued, Running, Succeeded, Failed, Canceled, Interrupted",
                  "disabled": true
                },
                {
                  "key": "mediaKind",
                  "value": "Video",
                  "description": "Image or Video",
                  "disabled": true
                },
                {
                  "key": "principalName",
                  "value": "default",
                  "description": "Submitting key name",
                  "disabled": true
                },
                {
                  "key": "fromUtc",
                  "value": "2026-01-01T00:00:00Z",
                  "description": "Inclusive lower bound",
                  "disabled": true
                },
                {
                  "key": "toUtc",
                  "value": "2030-01-01T00:00:00Z",
                  "description": "Exclusive upper bound",
                  "disabled": true
                },
                {
                  "key": "pageNumber",
                  "value": "1",
                  "description": "From 1",
                  "disabled": false
                },
                {
                  "key": "pageSize",
                  "value": "25",
                  "description": "1 to 1000",
                  "disabled": false
                }
              ]
            },
            "description": "Newest first. Uncomment filters as needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
