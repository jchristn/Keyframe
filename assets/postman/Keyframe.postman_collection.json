{
  "info": {
    "name": "Keyframe",
    "_postman_id": "5b8c3f0e-6a4d-4f1e-9a37-0c2d9e5b7a10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Keyframe v0.1.0 (ALPHA) REST API: summaries and typed metadata from images and video.\n\nSet the collection variables before sending: protocol, host, and port build baseUrl; accessKey is sent as x-api-key on every request; adminKey is used by admin-only requests (settings, restart, endpoint tests, request history deletion). sampleImageUrl and sampleVideoUrl must be publicly reachable, because the server refuses private-network URLs by default.\n\nRun order that exercises everything: System, Image, Video / Analyze video (job), Jobs / Get job until Succeeded, Jobs / Get job result, then Endpoints, Settings, and Request History. Full reference: REST_API.md in the repository."
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{accessKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "protocol",
      "value": "http",
      "description": "http or https"
    },
    {
      "key": "host",
      "value": "127.0.0.1",
      "description": "Server host"
    },
    {
      "key": "port",
      "value": "8700",
      "description": "Server port"
    },
    {
      "key": "baseUrl",
      "value": "{{protocol}}://{{host}}:{{port}}",
      "description": "Built from protocol, host, and port"
    },
    {
      "key": "accessKey",
      "value": "default",
      "description": "Data-plane access key (Auth.AccessKeys)"
    },
    {
      "key": "adminKey",
      "value": "keyframeadmin",
      "description": "Admin key (Auth.AdminApiKey). Change it on any shared server."
    },
    {
      "key": "endpointName",
      "value": "mock",
      "description": "Endpoint name from Inference.Endpoints"
    },
    {
      "key": "sampleImageUrl",
      "value": "https://upload.wikimedia.org/wikipedia/commons/3/3a/Cat03.jpg",
      "description": "Publicly reachable image URL"
    },
    {
      "key": "sampleVideoUrl",
      "value": "https://download.samplelib.com/mp4/sample-5s.mp4",
      "description": "Publicly reachable video URL"
    },
    {
      "key": "sampleImageBase64",
      "value": "",
      "description": "Base64 image bytes for the inline example"
    },
    {
      "key": "jobId",
      "value": "",
      "description": "Set by the Video folder test scripts"
    },
    {
      "key": "requestHistoryId",
      "value": "",
      "description": "Set by List request history"
    },
    {
      "key": "settingsBody",
      "value": "",
      "description": "Set by Get settings; sent by Update settings"
    }
  ],
