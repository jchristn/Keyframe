        {
          "name": "Get job result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1.0/jobs/{{jobId}}/result",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1.0",
                "jobs",
                "{{jobId}}",
                "result"
