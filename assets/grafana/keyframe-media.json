      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(keyframe_ffmpeg_invocations_total{operation=~\"$operation\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
