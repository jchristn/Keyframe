            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(keyframe_jobs_total{outcome=~\"failed|interrupted\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(keyframe_jobs_total[$__rate_interval])), 1e-9)",
