      "id": 9,
      "type": "timeseries",
      "title": "Stage p95",
      "description": "Per-stage p95: resolve, probe, normalize, scenedetection, frameextraction, audioextraction, transcribe, scenes, summarize, extract.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
