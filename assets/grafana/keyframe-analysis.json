        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le,media_kind) (rate(keyframe_analysis_duration_seconds_bucket{media_kind=~\"$media_kind\"}[$__rate_interval])))",
          "legendFormat": "{{media_kind}} p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le,media_kind) (rate(keyframe_analysis_duration_seconds_bucket{media_kind=~\"$media_kind\"}[$__rate_interval])))",
          "legendFormat": "{{media_kind}} p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le,media_kind) (rate(keyframe_analysis_duration_seconds_bucket{media_kind=~\"$media_kind\"}[$__rate_interval])))",
          "legendFormat": "{{media_kind}} p99",
          "range": true
        }
