    {
      "id": 14,
      "type": "table",
      "title": "Slowest recent analyses",
      "description": "Analyses over one second. Each trace shows stage:<Name> spans and inference spans beneath the analysis root.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"keyframe-server\" && name =~ \"analysis:.*\" && duration > 1s }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
