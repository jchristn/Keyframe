          "expr": "histogram_quantile(0.95, sum by (le,media_kind, stage) (rate(keyframe_stage_duration_seconds_bucket{media_kind=~\"$media_kind\"}[$__rate_interval])))",
          "legendFormat": "{{media_kind}} {{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
