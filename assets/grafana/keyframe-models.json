{
  "uid": "keyframe-models",
  "title": "Keyframe Models",
  "description": "Model calls through the inference seam: rate and failures by purpose and provider, latency, token usage, and endpoint health.",
  "tags": [
    "keyframe"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
