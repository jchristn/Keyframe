      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(keyframe_model_calls_total{provider=~\"$provider\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
