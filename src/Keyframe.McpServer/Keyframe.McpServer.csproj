<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Keyframe.McpServer</RootNamespace>
    <AssemblyName>Keyframe.McpServer</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Keyframe MCP server: exposes Keyframe image and video analysis to agents over MCP (Voltaic).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\csharp\Keyframe.Sdk\Keyframe.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radiant" Version="0.1.3" />
    <PackageReference Include="SyslogLogging" Version="2.4.1" />
    <PackageReference Include="Voltaic" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="keyframe-mcp.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
